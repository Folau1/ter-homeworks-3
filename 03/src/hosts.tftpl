[webservers]
%{ for vm in webservers ~}
${vm.name} ansible_host=${coalesce(vm.network_interface[0].nat_ip_address, vm.network_interface[0].ip_address)} fqdn=${vm.fqdn}
%{ endfor ~}

[databases]
%{ for vm in databases ~}
${vm.name} ansible_host=${coalesce(vm.network_interface[0].nat_ip_address, vm.network_interface[0].ip_address)} fqdn=${vm.fqdn}
%{ endfor ~}

[storage]
%{ for vm in storage ~}
${vm.name} ansible_host=${coalesce(vm.network_interface[0].nat_ip_address, vm.network_interface[0].ip_address)} fqdn=${vm.fqdn}
%{ endfor ~}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/home/alex/.ssh/yc-homework
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand="ssh -i /home/alex/.ssh/yc-homework -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -W %h:%p ubuntu@${bastion_ip}"'